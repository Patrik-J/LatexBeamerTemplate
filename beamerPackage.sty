\usepackage[math-style=ISO, partial=upright, mathup=text]{unicode-math} % math font
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{tikz}
\usetikzlibrary{calc,shadings}
\usetikzlibrary{patterns,snakes}
\usetikzlibrary{patterns.meta}
\usetikzlibrary{arrows.meta}

% init
\NewDocumentCommand{\InitBeamer}{momomomoo}{%
    \IfNoValueTF{#2}{\title{#1}}{\title[#2]{#1}}%
    \IfNoValueTF{#4}{\subtitle{#3}}{\subtitle[#4]{#3}}%
    \IfNoValueTF{#6}{\author{#5}}{\author[#6]{#5}}%
    \IfNoValueTF{#8}{\institute{#7}}{\institute[#8]{#7}}%

    \IfNoValueTF{#9}
    {\date{\today}}
    {\date{#9}}%
}

% general theme
\usetheme{Madrid}

% path
\makeatletter
\def\input@path{{./LatexBeamerTemplate/}}
\makeatother

% color theme
\usecolortheme{beamertheme}

% color definition
\definecolor{mntfcolor}{HTML}{13574d}

% links
\hypersetup{
    colorlinks = true,
    pdfauthor = {Author},
    pdftitle = {\LaTeX Beamer Presentation},
    citecolor = blue,
    filecolor = black!20!mntfcolor,
    linkcolor = mntfcolor,
    urlcolor = mntfcolor,
}

% beamer colors
\setbeamercolor{footline title link}{fg=white}
\addtobeamertemplate{footline}{\hypersetup{linkcolor=white}}{}

\setbeamercolor{itemize item}{fg=mntfcolor}
\setbeamercolor{itemize subitem}{fg=black}

\setbeamercolor{author in head/foot}{parent=palette primary,bg=}
\setbeamercolor{title in head/foot}{parent=palette secondary,bg=}
\setbeamercolor{date in head/foot}{parent=palette tertiary,bg=}

\setbeamercolor{section in head/foot}{parent=palette primary,bg=}
\setbeamercolor{subsection in head/foot}{parent=palette secondary,bg=}

% itemize
\setmathfont{New Computer Modern Math}[version=itemfont]
\setbeamertemplate{itemize item}{\mathversion{itemfont}$\diamond$}

% logo
\newcommand{\mylogo}{\includegraphics[width=3cm]{logo.png}}
\newcommand{\titleLogo}{\includegraphics[width=5cm]{titleLogo.png}}

\addtobeamertemplate{background}{}{
    \ifnum\value{framenumber}>1
        \begin{tikzpicture}[remember picture,overlay]
            \node[anchor=south east, xshift=0pt, yshift=0pt]
            at (current page.south east)
            {\mylogo};
        \end{tikzpicture}
    \else
        \begin{tikzpicture}[remember picture,overlay]
            \node[anchor=south, yshift = 10pt] at (current page.south)
            {\titleLogo};
        \end{tikzpicture}
    \fi
}

% TOC entry symbols
\setbeamertemplate{section in toc}{%
    \bfseries\color{mntfcolor}$\blacktriangleright$~\inserttocsection\par%
}%

\setbeamertemplate{subsection in toc}{%
    \hspace*{2em}\color{mntfcolor}$\square$~\inserttocsubsection\par%
}%

% color gradient
\colorlet{colorLeft}{mntfcolor}
\colorlet{colorMiddle}{mntfcolor!80!white}
\colorlet{colorRight}{mntfcolor!60!white}

\pgfdeclarehorizontalshading[colorLeft,colorMiddle,colorRight]
{colorGradient}{\paperheight}{
    color(0pt)=(colorLeft);
    color(0.6\paperwidth)=(colorMiddle);
    color(\paperwidth)=(colorRight)
}

% footer
\makeatletter%
\setbeamertemplate{footline}%
{%
    \leavevmode%
    \hypersetup{linkcolor=white}%
    \setbox\beamer@tempbox=\hbox{%
        \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
            \usebeamerfont{author in head/foot}\insertshortauthor\expandafter\beamer@ifempty\expandafter{\beamer@shortinstitute}{}{~~(\insertshortinstitute)}%
        \end{beamercolorbox}%
        \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
            \usebeamerfont{title in head/foot}\insertshorttitle%
        \end{beamercolorbox}%
        \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,right]{date in head/foot}%
            \usebeamerfont{date in head/foot}\insertshortdate{}\hspace*{2em}%
            \insertframenumber{} / \inserttotalframenumber{}\hspace*{2ex}%
        \end{beamercolorbox}%
    }%
    \beamer@tempdim=\ht\beamer@tempbox%
    \advance\beamer@tempdim by 4pt%
    \begin{tikzpicture}[remember picture,overlay]%
        \path[shade, left color=colorLeft, middle color=colorMiddle, right color=colorRight]%
        (0,0) rectangle (\paperwidth,\beamer@tempdim);%
    \end{tikzpicture}%
    \vskip-\beamer@tempdim%
    \box\beamer@tempbox% 
}%

% show TOC in between (sub-)sections
\newcommand{\InBetweenTOC}[1]{%
    \AtBeginSection[]{%
        \begin{frame}[noframenumbering]%
            \frametitle{#1}%
            \tableofcontents[currentsection, hideothersubsections]%
        \end{frame}%
    }%
}%

\newcommand{\InBetweenSubTOC}[1]{%
    \AtBeginSubsection[]{%
        \begin{frame}[noframenumbering]%
            \frametitle{#1}%
            \tableofcontents%
            [%
                currentsection,%
                currentsubsection,%
                subsectionstyle=show/shaded/hide%
            ]%
        \end{frame}%
    }%
}%

% no header
\newcommand{\NoHeader}{%
    \setbeamertemplate{headline}{}%   
}%

% title page
\newcommand{\showtitle}{%
    {%
        \hypersetup{linkcolor=white}%
        \begin{frame}%
            \titlepage%
        \end{frame}%
    }%
}%